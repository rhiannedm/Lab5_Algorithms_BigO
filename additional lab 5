# Sorting Algorithms with Metrics
def bubble_sort(arr):
    arr = arr.copy()
    comparisons = 0
    movements = 0
    n = len(arr)
    start_time = time.perf_counter()
    
    for i in range(n):
        for j in range(0, n-i-1):
            comparisons += 1
            if arr[j] > arr[j+1]:
                arr[j], arr[j+1] = arr[j+1], arr[j]
                movements += 3 # 3 assignments per swap
                
    end_time = time.perf_counter()
    return arr, comparisons, movements, (end_time - start_time)

def selection_sort(arr):
    arr = arr.copy()
    comparisons = 0
    movements = 0
    n = len(arr)
    start_time = time.perf_counter()
    
    for i in range(n):
        min_idx = i
        for j in range(i+1, n):
            comparisons += 1
            if arr[j] < arr[min_idx]:
                min_idx = j
        if min_idx != i:
            arr[i], arr[min_idx] = arr[min_idx], arr[i]
            movements += 3
                
    end_time = time.perf_counter()
    return arr, comparisons, movements, (end_time - start_time)

def insertion_sort(arr):
    arr = arr.copy()
    comparisons = 0
    movements = 0
    start_time = time.perf_counter()
    
    for i in range(1, len(arr)):
        key = arr[i]
        j = i - 1
        while j >= 0:
            comparisons += 1
            if arr[j] > key:
                arr[j + 1] = arr[j]
                movements += 1
                j -= 1
            else:
                break
        arr[j + 1] = key
        movements += 1 # Insertion
        
    end_time = time.perf_counter()
    return arr, comparisons, movements, (end_time - start_time)


def run_tests(input_name, data):
