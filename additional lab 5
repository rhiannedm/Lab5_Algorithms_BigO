        # Verify sorting
        is_sorted = all(sorted_arr[i] <= sorted_arr[i+1] for i in range(len(sorted_arr)-1))
        status = "Verified" if is_sorted else "Failed"
        
        print(f"{algo_name:<15} | {comps:<12} | {moves:<10} | {exec_time:.8f} ({status})")
    print()

